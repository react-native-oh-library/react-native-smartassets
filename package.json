{
    "name": "@react-native-oh-tpl/react-native-smartassets",
    "version": "1.1.0-rc.1",
    "description": "Smart load react native image resource both from apk(ipa) and jsbundle Dir.",
    "keywords": [
        "react-native",
        "harmony",
        "smartassets",
        "image"
    ],
    "homepage": "https://github.com/react-native-oh-library/react-native-smartassets",
    "repository": {
        "type": "git",
        "url": "https://github.com/react-native-oh-library/react-native-smartassets.git"
    },
    "license": "MIT",
    "author": "",
    "main": "index.js",
    "scripts": {
        "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-smartassets --cpp-output-path ./harmony/smartassets/src/main/cpp/generated --ets-output-path ./harmony/smartassets/src/main/ets/generated --turbo-modules-spec-paths ./src"
    },
    "dependencies": {
        "@react-native-oh/react-native-harmony": "0.77.22",
        "react-native": "0.77.1"
    },
    "devDependencies": {
        "@react-native-oh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.27",
        "react-native": "0.72.5"
    },
    "harmony": {
        "alias": "react-native-smartassets"
    }
}
